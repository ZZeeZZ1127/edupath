# ── AWS ───────────────────────────────────────────
AWS_REGION=us-east-1

# ── System 1: Recommendation ──────────────────────
# DynamoDB table name for student profiles
# (created via AWS Console)
# PROFILE_TABLE=studentProfiles

# ── System 2: Planning ────────────────────────────
# S3 bucket for storing generated plans
PLAN_BUCKET=edupath-plans

# HTTP endpoint of the recommend Lambda (for recalibration)
RECOMMEND_ENDPOINT=https://api.example.com/recommend

